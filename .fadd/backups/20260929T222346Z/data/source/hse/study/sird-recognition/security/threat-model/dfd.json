      "trustZone": "external",
      "componentId": null
    },
    {
      "id": "task-service",
      "type": "process",
      "name": "Task Service",
      "trustZone": "application",
      "componentId": "sird-workflow"
    },
    {
      "id": "process-service",
      "type": "process",
      "name": "Process Service",
      "trustZone": "application",
      "componentId": "sird-workflow"
    },
    {
      "id": "ocr-runtime",
      "type": "process",
