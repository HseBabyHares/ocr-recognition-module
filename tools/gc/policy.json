{
  "schemaVersion": "1.0",
  "maxFileLines": 800,
  "maxFileBytes": 2097152,
  "maxTodoPerFile": 10,
  "duplicateBlockLines": 8,
  "recurrenceThreshold": 3,
  "exclude": [
    ".git/**",
    ".venv/**",
    "venv/**",
    "build/**",
    "dist/**",
    "node_modules/**",
    "artifacts/**",
    ".cache/**",
    ".codegraph/**",
    ".claude/worktrees/**",
    "**/.git/**",
    "**/.venv/**",
    "**/venv/**",
    "**/__pycache__/**",
    "**/.cache/**",
    "**/.ruff_cache/**",
    "**/.pytest_cache/**",
    "**/build/**",
    "**/dist/**",
    "**/node_modules/**",
    "docs/archive/**",
    ".fadd/backups/**",
    ".claude/commands/**",
    ".claude/skills/**",
    ".omp/commands/**",
    ".omp/skills/**",
    "**/rendered/**",
    "**/uv.lock",
    "repomix-*.json",
    "*.db",
    "*.db-*",
    "*.pdf",
    "*.xlsx",
    "*.docx"
  ],
  "protectedControls": [
    "APPEND_SYSTEM.md",
    ".github/workflows/**",
    "tools/**",
    "schemas/**",
    "architecture/policy.json",
    "security/threat-model/exceptions/**",
    "quality/baseline.json"
  ]
}
