{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewer",
    "verdict",
    "confidence",
    "summary",
    "findings",
    "coverage",
    "blindSpots"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "inconclusive",
        "blocked"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blindSpots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fingerprint",
          "severity",
          "category",
          "criterion",
          "path",
          "line",
          "condition",
          "impact",
          "evidence",
          "confidence",
          "blockingCandidate"
        ],
        "properties": {
          "fingerprint": {
            "type": "string",
            "minLength": 8
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "category": {
            "enum": [
              "spec-drift",
              "correctness",
              "architecture",
              "security",
              "reliability",
              "test-oracle",
              "authority"
            ]
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "blockingCandidate": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
