{
  "schemaVersion": "1.0",
  "reviewedCommit": "working-tree-2026-09-20",
  "trustZones": [
    {
      "id": "external",
      "name": "Trusted SIRD backend boundary"
    },
    {
      "id": "application",
      "name": "SIRD workflow and OCR runtime"
    },
    {
      "id": "data",
      "name": "Durable state and artifact stores"
    },
    {
      "id": "identity",
      "name": "Workload identity control plane"
    }
  ],
  "trustBoundaries": [
    {
      "id": "external-to-application",
      "from": "external",
      "to": "application"
    },
    {
      "id": "application-to-data",
      "from": "application",
      "to": "data"
    },
    {
      "id": "identity-to-application",
      "from": "identity",
      "to": "application"
    }
  ],
  "elements": [
