      "trustBoundary": "identity-to-application"
    },
    {
      "id": "spiffe-to-process",
      "source": "spiffe",
      "target": "process-service",
      "data": [
        "SVID",
        "trust bundle",
        "role identity"
      ],
      "classifications": [
        "identity"
      ],
      "trustBoundary": "identity-to-application"
    }
  ],
