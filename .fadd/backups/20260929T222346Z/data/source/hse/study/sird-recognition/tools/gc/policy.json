{
  "schemaVersion": "1.0",
  "maxFileLines": 800,
  "maxFileBytes": 2097152,
  "maxTodoPerFile": 10,
  "recurrenceThreshold": 3,
  "exclude": [
    ".git/**",
    ".venv/**",
    "venv/**",
    "build/**",
    "dist/**",
    "node_modules/**",
    "artifacts/**",
    ".cache/**",
    ".codegraph/**",
    ".claude/worktrees/**",
    "**/.git/**",
    "**/.venv/**",
    "**/venv/**",
    "**/__pycache__/**",
    "**/.cache/**",
    "**/.ruff_cache/**",
    "**/.pytest_cache/**",
    "**/build/**",
    "**/dist/**",
    "**/node_modules/**",
    ".omp/**",
    ".claude/**",
    ".fadd/**",
    "tools/**",
    "agents/**",
    "skills/**",
    ".github/**",
    ".gitlab-ci.fadd.yml",
    "AGENTS.md",
    "APPEND_SYSTEM.md",
    "config.overlay.yml",
    "architecture/rendered/**",
    "docs/**",
    "uv.lock",
    "**/uv.lock",
    "bun.lock",
    "**/bun.lock",
    "docs/archive/**",
    "repomix-*.json",
    "*.db",
    "*.db-*",
    "*.pdf",
    "*.xlsx",
    "*.docx"
  ],
  "protectedControls": [
    "APPEND_SYSTEM.md",
    ".github/workflows/**",
    "tools/**",
    "schemas/**",
    "architecture/policy.json",
    "security/threat-model/exceptions/**",
    "quality/baseline.json"
  ]
}
