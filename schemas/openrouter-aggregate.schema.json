{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "requestedModels",
    "successfulModels",
    "findings",
    "errors"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "blocked",
        "skipped"
      ]
    },
    "requestedModels": {
      "type": "array"
    },
    "successfulModels": {
      "type": "array"
    },
    "findings": {
      "type": "array"
    },
    "errors": {
      "type": "array"
    }
  }
}
